# Игра — C++ со стандартной библиотекой (std::thread, std::vector), поэтому STL
# обязателен. Статический: STL пользуется только модуль main, SDL и mixer на C.
APP_STL := c++_static

# Только arm64: это и телефоны, и наш эмулятор на Apple Silicon. Остальные ABI
# утроили бы время сборки без пользы для проверки концепции.
APP_ABI := arm64-v8a

# 64-битные ABI появились в android-21, ниже собрать нельзя.
APP_PLATFORM := android-21
